{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "c4cker-main",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/main/server/entry.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/main/client",
    "not_found_handling": "404-page"
  }
}
