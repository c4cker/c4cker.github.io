---
<button class="language-switcher" type="button" role="switch" aria-label="Idioma: Español" aria-checked="false" data-language-switcher>
  <span class="sr-only">Idioma</span>
  <span class="language-flag language-flag--es" aria-hidden="true">ES</span>
  <span class="language-thumb" aria-hidden="true"></span>
  <span class="language-flag language-flag--en" aria-hidden="true">EN</span>
</button>

<script>
  import { englishText } from "../../../apps/main/src/scripts/i18n";
  import { translateDom } from "../i18n/translate-dom";

  const switcher = document.querySelector<HTMLButtonElement>("[data-language-switcher]");
  const translations: Record<string, string> = {
    "nav.home": "Home", "nav.blog": "Blog", "nav.writeups": "Writeups", "nav.projects": "Projects", "nav.challenges": "Challenges", "nav.labs": "Academy", "nav.labs.local": "Labs", "nav.hall": "Ranking", "nav.community": "Community", "nav.contact": "Contact", "nav.portfolio": "Portfolio",
    "footer.learning": "Responsible learning", "footer.privacy": "Privacy", "footer.terms": "Terms and conditions"
  };
  const languageKey = "c4cker-language";
  const applyEnglish = () => {
    document.documentElement.lang = "en";
    document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((element) => {
      const value = translations[element.dataset.i18n ?? ""];
      if (value) element.textContent = value;
    });
    translateDom(document, (key, options) => englishText[key] ?? options?.defaultValue ?? "", englishText);
    switcher?.setAttribute("aria-checked", "true");
    switcher?.setAttribute("aria-label", "Language: English");
  };
  const english = localStorage.getItem(languageKey) === "en";
  if (english) applyEnglish();
  switcher?.addEventListener("click", () => {
    localStorage.setItem(languageKey, english ? "es" : "en");
    window.location.reload();
  });
</script>
