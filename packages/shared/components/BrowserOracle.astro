---
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<aside class="browser-oracle" aria-label="Oráculo del navegador" data-browser-oracle>
  <section id="oraculo-local" class="oracle-panel" aria-hidden="true" data-oracle-panel>
    <header class="oracle-header">
      <span class="oracle-status" aria-hidden="true"></span>
      <div><strong data-oracle-title>Hola, soy Bob.</strong></div>
      <button class="oracle-close" type="button" aria-label="Cerrar oráculo" data-oracle-close>×</button>
    </header>
    <div class="oracle-log" aria-live="polite" data-oracle-log></div>
    <div class="oracle-choices" data-oracle-choices></div>
  </section>
  <button class="oracle-trigger" type="button" aria-expanded="false" aria-controls="oraculo-local" data-oracle-trigger>
    <img src={`${base}bob-avatar.jpg`} width="56" height="56" alt="" aria-hidden="true" />
    <span class="sr-only" data-oracle-trigger-label>Preguntale al oráculo</span>
  </button>
</aside>

<script>
  const root = document.querySelector<HTMLElement>("[data-browser-oracle]");
  const panel = root?.querySelector<HTMLElement>("[data-oracle-panel]");
  const trigger = root?.querySelector<HTMLButtonElement>("[data-oracle-trigger]");
  const close = root?.querySelector<HTMLButtonElement>("[data-oracle-close]");
  const log = root?.querySelector<HTMLElement>("[data-oracle-log]");
  const choices = root?.querySelector<HTMLElement>("[data-oracle-choices]");
  const title = root?.querySelector<HTMLElement>("[data-oracle-title]");
  const triggerLabel = root?.querySelector<HTMLElement>("[data-oracle-trigger-label]");

  if (root && panel && trigger && close && log && choices && title && triggerLabel) {
    const signal = {
      language: navigator.language || "es",
      zone: Intl.DateTimeFormat().resolvedOptions().timeZone || "unknown",
      hour: new Date().getHours(),
      viewport: window.innerWidth < 768 ? "mobile" : "desktop"
    };
    const asked = new Set<string>();
    const browserName = () => {
      const agent = navigator.userAgent;
      if (/Edg\//.test(agent)) return "Microsoft Edge";
      if (/Firefox\//.test(agent)) return "Firefox";
      if (/CriOS\//.test(agent)) return "Chrome";
      if (/Chrome\//.test(agent)) return "Chrome";
      if (/Safari\//.test(agent)) return "Safari";
      return "un navegador no identificado";
    };
    const browserVersion = () => navigator.userAgent.match(/(?:Edg|Firefox|CriOS|Chrome|Version)\/([\d.]+)/)?.[1]?.split(".")[0] ?? "";
    const countryName = () => {
      const region = signal.zone.startsWith("America/Argentina/") || signal.zone === "America/Buenos_Aires" ? "AR" : new Intl.Locale(signal.language).region;
      if (!region) return "tu zona horaria";
      return new Intl.DisplayNames(["es"], { type: "region" }).of(region) ?? "tu zona horaria";
    };
    const addLine = (content: string, emphasis = false) => {
      const line = document.createElement("p");
      line.className = `oracle-line${emphasis ? " oracle-line--signal" : ""}`;
      line.textContent = content;
      log.append(line);
      log.scrollTop = log.scrollHeight;
    };
    const reply = async (content: string, emphasis = false, delay = 1200) => {
      const typing = document.createElement("p");
      typing.className = "oracle-typing";
      typing.innerHTML = "<span></span><span></span><span></span><b>Escribiendo…</b>";
      log.append(typing);
      log.scrollTop = log.scrollHeight;
      await new Promise((resolve) => window.setTimeout(resolve, delay));
      typing.remove();
      addLine(content, emphasis);
    };
    const button = (label: string, action: () => void) => {
      const element = document.createElement("button");
      element.type = "button";
      element.className = "oracle-choice";
      element.textContent = label;
      element.addEventListener("click", action);
      choices.append(element);
    };
    const reset = () => {
      log.replaceChildren(); choices.replaceChildren(); asked.clear();
      title.textContent = "Hola, soy Bob.";
      triggerLabel.textContent = "Preguntale al oráculo";
      addLine("¿Querés jugar un pequeño juego?");
      showQuestions();
    };
    const revealDevice = async () => {
      asked.add("device"); choices.replaceChildren();
      const agent = navigator.userAgent;
      const system = /Windows NT 10\.0/.test(agent) ? "Windows 10" : /Windows/.test(agent) ? "Windows" : /Android/.test(agent) ? "Android" : /iPhone|iPad/.test(agent) ? "iOS" : /Mac OS X/.test(agent) ? "macOS" : /Linux/.test(agent) ? "Linux" : "sistema no identificado";
      const userAgentData = (navigator as Navigator & { userAgentData?: { architecture?: string } }).userAgentData;
      const architectureHint = userAgentData?.architecture?.toLowerCase();
      const architecture = architectureHint?.includes("arm") ? "ARM" : architectureHint?.includes("86") || architectureHint?.includes("x64") ? "x64" : /Win64|x86_64|amd64|x64/.test(agent) ? "x64" : /arm64|aarch64|armv/i.test(agent) ? "ARM" : "arquitectura no disponible";
      await reply(`Abriste desde ${system}. Arquitectura detectada: ${architecture}.`, true);
      showQuestions();
    };
    const revealEnvironment = async () => {
      asked.add("environment"); choices.replaceChildren();
      const time = new Intl.DateTimeFormat("es-AR", { hour: "2-digit", minute: "2-digit", hour12: false }).format(new Date());
      await reply(`Usás ${browserName()} ${browserVersion()}, sos de ${countryName()} y son las ${time} donde estás.`, true);
      showQuestions();
    };
    const revealCapabilities = async () => {
      asked.add("capabilities"); choices.replaceChildren();
      const navigatorSpecs = navigator as Navigator & { deviceMemory?: number };
      const logicalProcessors = navigator.hardwareConcurrency === undefined ? "No pude detectar la cantidad de hilos lógicos de tu CPU" : `tu CPU tiene ${navigator.hardwareConcurrency} hilos lógicos`;
      const memory = navigatorSpecs.deviceMemory === undefined ? "y no pude estimar la memoria RAM disponible" : `Tu memoria RAM es ${navigatorSpecs.deviceMemory} GiB`;
      await reply(`${memory} y ${logicalProcessors}.`, true);
      showQuestions();
    };
    const revealNetwork = async () => {
      asked.add("network"); choices.replaceChildren();
      try {
        const result = await fetch("https://api4.ipify.org?format=json", { headers: { Accept: "application/json" } });
        const payload = await result.json();
        if (!result.ok || !/^\d{1,3}(?:\.\d{1,3}){3}$/.test(payload.ip ?? "")) throw new Error("ipv4 unavailable");
        await reply(`Tu IPv4 pública es ${payload.ip}.`, true);
      } catch {
        await reply("No pude encontrar una IPv4 pública desde este entorno.", true);
      }
      await new Promise((resolve) => window.setTimeout(resolve, 2500));
      await reply("Oh no, me metí con la persona equivocada…", true, 2500);
      window.setTimeout(() => {
        root.classList.add("is-glitching");
        panel.setAttribute("aria-hidden", "true");
        trigger.setAttribute("aria-expanded", "false");
        window.setTimeout(() => {
          root.classList.remove("is-open", "is-glitching");
          root.classList.add("is-gone");
          trigger.tabIndex = -1;
        }, 420);
      }, 2800);
    };
    const showQuestions = () => {
      choices.replaceChildren();
      if (!asked.has("device")) button("¿Desde dónde abrí la página?", revealDevice);
      if (!asked.has("environment")) button("Decime algo más", revealEnvironment);
      if (!asked.has("capabilities")) button("¿Qué puede hacer mi navegador?", revealCapabilities);
      if (asked.has("device") && asked.has("environment") && asked.has("capabilities") && !asked.has("network")) button("¿Querés que te diga tu IP?", revealNetwork);
    };
    const setOpen = (open: boolean) => {
      root.classList.toggle("is-open", open);
      panel.setAttribute("aria-hidden", String(!open));
      trigger.setAttribute("aria-expanded", String(open));
      if (open) reset();
    };
    trigger.addEventListener("click", () => setOpen(!root.classList.contains("is-open")));
    close.addEventListener("click", () => setOpen(false));
    document.addEventListener("keydown", (event) => { if (event.key === "Escape") setOpen(false); });
  }
</script>
