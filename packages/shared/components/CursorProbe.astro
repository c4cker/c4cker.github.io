<div class="cursor-probe" data-cursor-probe aria-hidden="true"><span class="lava-core"></span><span class="lava-drop"></span><span class="lava-glint"></span></div>

<script>
  // @ts-nocheck - animación deliberadamente imperativa para mantenerla fuera del render.
  window.__c4ckerCursorCleanup?.();
  const renderedProbe = document.querySelector("[data-cursor-probe]");
  const probe = renderedProbe?.cloneNode(true);
  if (renderedProbe && probe) renderedProbe.replaceWith(probe);
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const touchLayout = window.matchMedia("(pointer: coarse), (hover: none), (max-width: 1023px)").matches;
  if (probe && !reduceMotion && !touchLayout) {
    const listenerController = new AbortController();
    const baseSize = 70;
    const logo = document.querySelector("[data-glitch-logo]");
    const targets = [...document.querySelectorAll("a.card:not([href*='/laboratorios']), [data-probe-button]")];
    const excludedControls = [...document.querySelectorAll("a, button, input, textarea, select")].filter((element) => element !== logo && !targets.includes(element));
    let x = window.innerWidth * .52, y = window.innerHeight * .45, currentX = x - baseSize / 2, currentY = y - baseSize / 2, currentWidth = baseSize, currentHeight = baseSize, activeTarget = null, logoHovered = false, logoZoneSuppressed = false, excludedHoverTarget = null, excludedFocusTarget = null, pointerControlTarget = null, animationFrameId = 0, running = true;
    const controlTarget = () => excludedHoverTarget ?? excludedFocusTarget ?? pointerControlTarget;
    const bubbleSuppressed = () => logoHovered || logoZoneSuppressed || Boolean(controlTarget());
    const distanceTo = (box) => Math.hypot(Math.max(box.left - x, 0, x - box.right), Math.max(box.top - y, 0, y - box.bottom));
    const setActive = (next) => {
      if (bubbleSuppressed()) next = null;
      document.querySelectorAll(".probe-target.is-owned").forEach((element) => { if (element !== next) element.classList.remove("is-owned"); });
      if (next === activeTarget) return;
      activeTarget?.classList.remove("is-owned"); activeTarget = next;
      probe.classList.toggle("is-docking", Boolean(activeTarget)); activeTarget?.classList.add("is-owned");
    };
    const syncSuppression = () => {
      const box = logo?.getBoundingClientRect();
      const swallowedControl = controlTarget();
      logoZoneSuppressed = !swallowedControl && Boolean(box && x >= box.left - 76 && x <= box.right + 76 && y >= box.top - 48 && y <= box.bottom + 48);
      const logoHidden = !swallowedControl && (logoHovered || logoZoneSuppressed);
      probe.classList.toggle("is-logo-hidden", logoHidden);
      probe.classList.toggle("is-control-hidden", Boolean(swallowedControl));
      if (bubbleSuppressed()) setActive(null);
    };
    const tick = () => {
      if (!running || !probe.isConnected) return;
      let aimWidth = baseSize, aimHeight = baseSize, aimX = x - baseSize / 2, aimY = y - baseSize / 2;
      if (activeTarget?.isConnected) {
        const box = activeTarget.getBoundingClientRect();
        aimWidth = box.width + 2;
        aimHeight = box.height + 2;
        aimX = box.left + (box.width - aimWidth) / 2;
        aimY = box.top + (box.height - aimHeight) / 2;
        probe.style.setProperty("--dock-radius", getComputedStyle(activeTarget).borderRadius || ".85rem");
      } else if (controlTarget()?.isConnected) {
        const box = controlTarget().getBoundingClientRect();
        aimX = box.left + box.width / 2 - baseSize / 2;
        aimY = box.top + box.height / 2 - baseSize / 2;
      }
      const follow = activeTarget ? .14 : controlTarget() ? .38 : .1;
      currentX += (aimX - currentX) * follow; currentY += (aimY - currentY) * follow; currentWidth += (aimWidth - currentWidth) * .12; currentHeight += (aimHeight - currentHeight) * .12;
      probe.style.width = `${currentWidth}px`; probe.style.height = `${currentHeight}px`; probe.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;
      animationFrameId = requestAnimationFrame(tick);
    };
    const moveProbe = (event) => {
      if ("pointerType" in event && event.pointerType === "touch") return;
      probe.classList.add("is-visible"); x = event.clientX; y = event.clientY;
      const elementAtPointer = document.elementFromPoint(x, y)?.closest("a, button, input, textarea, select");
      pointerControlTarget = elementAtPointer && excludedControls.includes(elementAtPointer) ? elementAtPointer : null;
      syncSuppression();
      if (bubbleSuppressed()) return;
      const nearby = targets.map((element) => ({ element, distance: distanceTo(element.getBoundingClientRect()) })).filter(({ distance }) => distance < 18).sort((a, b) => a.distance - b.distance)[0]; setActive(nearby?.element ?? null);
    };
    targets.forEach((element) => { element.classList.add("probe-target"); element.addEventListener("pointerenter", () => setActive(element), { signal: listenerController.signal }); element.addEventListener("pointerleave", () => { if (activeTarget === element) setActive(null); }, { signal: listenerController.signal }); element.addEventListener("focusin", () => setActive(element), { signal: listenerController.signal }); element.addEventListener("focusout", () => { if (activeTarget === element) setActive(null); }, { signal: listenerController.signal }); element.addEventListener("pointermove", (event) => { const box = element.getBoundingClientRect(); element.style.setProperty("--probe-x", `${event.clientX - box.left}px`); element.style.setProperty("--probe-y", `${event.clientY - box.top}px`); }, { signal: listenerController.signal }); });
    excludedControls.forEach((element) => { element.addEventListener("pointerenter", () => { excludedHoverTarget = element; syncSuppression(); }, { signal: listenerController.signal }); element.addEventListener("pointerleave", () => { if (excludedHoverTarget === element) excludedHoverTarget = null; syncSuppression(); }, { signal: listenerController.signal }); element.addEventListener("focusin", () => { excludedFocusTarget = element; syncSuppression(); }, { signal: listenerController.signal }); element.addEventListener("focusout", () => { if (excludedFocusTarget === element) excludedFocusTarget = null; syncSuppression(); }, { signal: listenerController.signal }); });
    window.addEventListener("c4cker:logo-enter", () => { logoHovered = true; syncSuppression(); }, { signal: listenerController.signal });
    window.addEventListener("c4cker:logo-leave", () => { logoHovered = false; syncSuppression(); }, { signal: listenerController.signal });
    window.addEventListener("pointermove", moveProbe, { passive: true, signal: listenerController.signal }); window.addEventListener("mousemove", moveProbe, { passive: true, signal: listenerController.signal });
    const cleanup = () => { running = false; cancelAnimationFrame(animationFrameId); listenerController.abort(); targets.forEach((element) => element.classList.remove("is-owned", "probe-target")); if (window.__c4ckerCursorCleanup === cleanup) delete window.__c4ckerCursorCleanup; };
    window.__c4ckerCursorCleanup = cleanup;
    if (import.meta.hot) import.meta.hot.dispose(cleanup);
    animationFrameId = requestAnimationFrame(tick);
  }
</script>
