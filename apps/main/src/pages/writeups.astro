---
import Base from "../layouts/MainLayout.astro";
const modules = import.meta.glob("../content/writeups/*.md", { eager: true });
const writeups = Object.values(modules).map((module: any) => module.frontmatter).sort((a: any, b: any) => a.order - b.order);
---
<Base title="Writeups" description="Resoluciones de CTF y máquinas, con comandos, evidencias y referencias.">
  <article class="container-site max-w-6xl py-16 sm:py-20">
    <div><h1 class="mt-3 font-display text-5xl font-bold tracking-[-.07em] sm:text-6xl">Writeups <br /><span class="text-electric">y resoluciones</span></h1><p class="mt-5 max-w-2xl text-lg text-[#cbd5e1]">Resoluciones de CTF y máquinas, con comandos, evidencias y referencias.</p></div>
    <div class="writeup-controls mt-10" data-writeup-search><label class="sr-only" for="writeup-query">Buscar writeups</label><input id="writeup-query" type="search" maxlength="120" placeholder="Buscar por plataforma, técnica o etiqueta" autocomplete="off" data-query /><div class="mt-3 flex flex-wrap gap-2" aria-label="Filtrar por dificultad"><button class="filter-button is-active" type="button" data-filter="all">Todos</button><button class="filter-button" type="button" data-filter="fácil">Fácil</button><button class="filter-button" type="button" data-filter="medio">Medio</button><button class="filter-button" type="button" data-filter="difícil">Difícil</button><button class="filter-button" type="button" data-filter="insano">Insano</button></div></div>
    {writeups.length > 0 ? <><p class="mt-5 font-mono text-xs text-[#929991]" data-results-count>{writeups.length} writeups publicados</p><div class="mt-5 grid gap-4 md:grid-cols-2" data-writeup-list>{writeups.map((item: any) => <a class="card trace-card group" href={`/writeups/${item.slug}`} data-writeup-card data-level={item.level} data-search={`${item.title} ${item.platform} ${item.kind} ${item.tags.join(" ")}`.toLowerCase()}><div class="flex items-start justify-between gap-3"><span class="eyebrow">{item.platform}</span><span class="font-mono text-[10px] uppercase text-ember">{item.status}</span></div><h2 class="mt-4 font-display text-3xl font-bold tracking-[-.04em] group-hover:text-signal">{item.title}</h2><p class="mt-1 font-mono text-xs text-electric">{item.kind} · {item.level} · {item.date}</p><p class="mt-4 text-[#a9b6c8]">{item.description}</p><div class="mt-5 flex flex-wrap gap-2">{item.tags.map((tag: string) => <span class="data-chip">{tag}</span>)}</div><span class="route-link mt-7">Ver resolución <span aria-hidden="true">→</span></span></a>)}</div><p class="mt-8 hidden border-l border-ember pl-4 font-mono text-sm text-[#a9b6c8]" data-empty>No hay writeups que coincidan. Cambiá el filtro o probá otra búsqueda.</p></> : <p class="mt-10 border-l border-ember pl-4 font-mono text-sm text-[#a9b6c8]">Todavía no hay writeups publicados.</p>}
  </article>
  <script>
    // @ts-nocheck - script del filtro nativo; se migrará a TS al crecer la búsqueda.
    const root = document.querySelector("[data-writeup-search]"); const cards = [...document.querySelectorAll("[data-writeup-card]")]; const counter = document.querySelector("[data-results-count]"); const empty = document.querySelector("[data-empty]"); let level = "all";
    const update = () => { const rawQuery = root?.querySelector("[data-query]")?.value ?? ""; const query = rawQuery.replace(/[\u0000-\u001F\u007F]/g, "").toLowerCase().trim().slice(0, 120); const visible = cards.filter((card) => { const matchLevel = level === "all" || card.dataset.level === level; const matchQuery = !query || card.dataset.search.includes(query); card.classList.toggle("hidden", !(matchLevel && matchQuery)); return matchLevel && matchQuery; }); if (counter) counter.textContent = `${visible.length} ${visible.length === 1 ? "writeup publicado" : "writeups publicados"}`; empty?.classList.toggle("hidden", visible.length !== 0); };
    root?.querySelector("[data-query]")?.addEventListener("input", update); root?.querySelectorAll("[data-filter]").forEach((button) => button.addEventListener("click", () => { level = button.dataset.filter ?? "all"; root.querySelectorAll("[data-filter]").forEach((item) => item.classList.toggle("is-active", item === button)); update(); }));
  </script>
</Base>
