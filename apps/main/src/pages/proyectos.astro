---
import Base from "../layouts/MainLayout.astro";
import { projects } from "../data/projects";
---
<Base title="Proyectos" description="Herramientas, plantillas y experimentos creados por c4cker."><article class="container-site max-w-6xl py-16 sm:py-20"><div class="max-w-3xl"><h1 class="mt-3 font-display text-5xl font-bold tracking-[-.07em] sm:text-6xl">Propuestas<br /></h1><p class="mt-5 text-lg text-[#cbd5e1]">Herramientas y plantillas para ciberseguridad. Las ideas y aportes son bienvenidos.</p></div>{projects.length > 0 ? <div class="mt-12 grid gap-4 md:grid-cols-2">{projects.map((item) => <a class="card trace-card group" href={`/proyectos/${item.slug}`}><div class="flex justify-between gap-3"><span class="eyebrow">{item.kind}</span><span class="font-mono text-[10px] uppercase text-ember">{item.status}</span></div><h2 class="mt-4 font-display text-3xl font-bold tracking-[-.04em] group-hover:text-signal">{item.title}</h2><p class="mt-2 font-mono text-xs text-electric">{item.stack}</p><p class="mt-4 text-[#a9b6c8]">{item.description}</p><span class="route-link mt-7">Ver proyecto <span aria-hidden="true">→</span></span></a>)}</div> : <p class="mt-12 border-l border-ember pl-4 font-mono text-sm text-[#a9b6c8]">Próximamente voy a publicar proyectos propios.</p>}</article></Base>
