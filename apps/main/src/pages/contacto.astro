---
import Base from "../layouts/MainLayout.astro";
---

<Base title="Contacto" description="Canal público para contactar a Luciano Plaza y proponer recursos o colaboraciones.">
  <article class="container-site max-w-3xl py-16 sm:py-20">
    <h1 class="mt-3 font-display text-5xl font-bold tracking-[-.07em] sm:text-6xl">Hablemos<br /></h1>
    <p class="mt-5 max-w-2xl text-lg text-[#cbd5e1]">Para una corrección, una propuesta o una colaboración, dejame el contexto y el alcance. No incluyas secretos, flags ni información sensible.</p>

    <form class="contact-form mt-12" data-contact-form>
      <div class="contact-form__head"><div><p class="eyebrow">Formulario</p><h2 class="mt-3 font-display text-3xl font-bold">Dejame un mensaje</h2></div><span class="contact-form__state" data-state-label hidden></span></div>
      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        <label>Nombre<input name="name" autocomplete="name" placeholder="Tu nombre" required /></label>
        <label>Correo<input name="email" type="email" autocomplete="email" placeholder="nombre@dominio.com" required /></label>
      </div>
      <label class="mt-5 block">Asunto<input name="subject" placeholder="Motivo del mensaje" required /></label>
      <label class="mt-5 block">Mensaje<textarea name="message" rows="6" placeholder="Contexto, alcance y cualquier enlace público relevante" required></textarea></label>
      <div class="mt-7 flex flex-wrap items-center justify-between gap-4"><button class="contact-form__submit" type="submit">Enviar <span aria-hidden="true">→</span></button></div>
      <p class="contact-form__notice" role="status" aria-live="polite" hidden></p>
    </form>
  </article>
  <script>
    const FORM_URL = import.meta.env.PUBLIC_GOOGLE_FORM_URL;
    const ENTRY = {
      name: import.meta.env.PUBLIC_GOOGLE_ENTRY_NAME,
      email: import.meta.env.PUBLIC_GOOGLE_ENTRY_EMAIL,
      subject: import.meta.env.PUBLIC_GOOGLE_ENTRY_SUBJECT,
      message: import.meta.env.PUBLIC_GOOGLE_ENTRY_MESSAGE,
    };

    const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
    const notice = document.querySelector<HTMLElement>(".contact-form__notice");
    const stateLabel = document.querySelector<HTMLElement>("[data-state-label]");
    const submitBtn = form?.querySelector<HTMLButtonElement>("button[type=submit]");

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const body = new URLSearchParams({
        [ENTRY.name]: data.get("name") as string,
        [ENTRY.email]: data.get("email") as string,
        [ENTRY.subject]: data.get("subject") as string,
        [ENTRY.message]: data.get("message") as string,
      });
      if (submitBtn) submitBtn.disabled = true;
      if (stateLabel) { stateLabel.textContent = "enviando…"; stateLabel.hidden = false; }
      try {
        await fetch(FORM_URL, { method: "POST", body, mode: "no-cors" });
        form.reset();
        if (stateLabel) stateLabel.textContent = "enviado";
        if (notice) { notice.textContent = "Mensaje recibido. Gracias por escribir."; notice.hidden = false; }
        setTimeout(() => {
          if (stateLabel) { stateLabel.textContent = ""; stateLabel.hidden = true; }
          if (notice) notice.hidden = true;
          if (submitBtn) submitBtn.disabled = false;
        }, 3000);
      } catch {
        if (stateLabel) stateLabel.textContent = "error";
        if (notice) { notice.textContent = "Error al enviar. Intentá de nuevo o escribime por LinkedIn."; notice.hidden = false; }
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  </script>
</Base>
