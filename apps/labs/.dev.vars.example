# Solo desarrollo local. Copiar como .dev.vars; el archivo real está ignorado.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_EN_CLOUDFLARE
FLAGS_JSON={"hello-local":"C4CKER{0123456789abcdefghijklmnopqrstuv}"}
# Variables públicas del cliente para Supabase Auth. No son secretos.
PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
# URL pública de inserción de Google Forms. No es una credencial.
PUBLIC_GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/TU_ID/viewform?embedded=true
