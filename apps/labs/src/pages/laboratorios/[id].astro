---
import Base from "../../layouts/LabsLayout.astro";
import { labs } from "../../data/laboratories";
export const prerender = true;
export function getStaticPaths() { return labs.map((lab) => ({ params: { id: lab.id }, props: { lab } })); }
const { lab } = Astro.props;
const laboratoriesHref = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/laboratorios`;
---
<Base title={lab.title} description={lab.description}><article class="container-site max-w-5xl py-16 sm:py-20"><a class="back-link font-mono" href={laboratoriesHref}>← Volver</a><p class="eyebrow mt-8">{lab.runtime} · {lab.time}</p><h1 class="mt-3 font-display text-5xl font-bold tracking-[-.07em] sm:text-6xl">{lab.title}</h1><p class="mt-5 max-w-3xl text-lg leading-8 text-[#cbd5e1]">{lab.description}</p><p class="mt-8 border-l-2 border-line pl-4 font-mono text-xs text-[#a9b6c8]">{lab.relation}</p><div class="mt-10 grid gap-4 md:grid-cols-2"><section class="border border-line bg-panel/70 p-5"><p class="eyebrow">Versiones</p><ul class="mt-4 space-y-3 text-sm leading-6 text-[#cbd5e1]">{lab.versions.map((version: string) => <li>· {version}</li>)}</ul></section><section class="border border-line bg-panel/70 p-5"><p class="eyebrow">Técnicas</p><ul class="mt-4 space-y-3 text-sm leading-6 text-[#cbd5e1]">{lab.techniques.map((technique: string) => <li>· {technique}</li>)}</ul></section></div><section class="mt-4 border border-line bg-panel/70 p-5"><p class="eyebrow">Secuencia del laboratorio</p><ol class="mt-4 space-y-3 text-sm leading-6 text-[#cbd5e1]">{lab.attackChain.map((step: string, index: number) => <li><span class="mr-2 font-mono text-electric">{String(index + 1).padStart(2, "0")}</span>{step}</li>)}</ol></section><p class="mt-8 border-l border-ember pl-4 text-sm leading-7 text-[#a9b6c8]"><span class="font-mono text-ember">ALCANCE:</span> {lab.scope}</p><p class="mt-8 max-w-3xl text-sm leading-6 text-[#a9b6c8]">Abrí el repositorio, seguí el README y mantené los servicios limitados a tu equipo. Anotá los comandos y las evidencias antes de apagar el entorno.</p><a class="mt-10 inline-block border border-signal bg-signal px-4 py-3 font-mono text-xs font-bold text-void no-underline hover:bg-transparent hover:text-signal" href={lab.repoUrl} target="_blank" rel="noreferrer noopener">Abrir repositorio</a></article></Base>
