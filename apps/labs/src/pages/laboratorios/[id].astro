---
import Base from "../../layouts/LabsLayout.astro";
import { labs } from "../../data/laboratories";
export const prerender = true;
export function getStaticPaths() { return labs.map((lab) => ({ params: { id: lab.id }, props: { lab } })); }
const { lab } = Astro.props;
---
<Base title={lab.title} description={lab.description}><article class="container-site max-w-4xl py-16 sm:py-20"><a class="back-link font-mono" href="/laboratorios">← Volver</a><p class="eyebrow mt-8">{lab.runtime}</p><h1 class="mt-3 font-display text-5xl font-bold tracking-[-.07em] sm:text-6xl">{lab.title}</h1><p class="mt-5 max-w-2xl text-lg text-[#cbd5e1]">{lab.description}</p><p class="mt-8 border-l-2 border-line pl-4 font-mono text-xs text-[#a9b6c8]">{lab.relation}</p><a class="mt-10 inline-block border border-signal bg-signal px-4 py-3 font-mono text-xs font-bold text-void no-underline hover:bg-transparent hover:text-signal" href={lab.repoUrl} target="_blank" rel="noreferrer noopener">Ir al repositorio →</a></article></Base>
