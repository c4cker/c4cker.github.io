---
import Base from "../layouts/LabsLayout.astro";
---
<Base title="Hall of Fame" description="Registro anónimo de solves verificados en los desafíos de c4cker.">
  <article class="container-site max-w-4xl py-20">
    <h1 class="mt-3 font-display text-6xl font-bold tracking-[-.07em]">Salón de la fama</h1>
    <p class="mt-5 max-w-2xl text-lg text-[#cbd5e1]">Un punto por desafío completado. Las etapas intermedias no suman puntaje.</p>
    <div class="mt-10 border border-line bg-panel p-6" data-ranking-state><p class="text-[#a9b6c8]">Cargando ranking…</p></div>
  </article>
  <script is:inline define:vars={{ apiUrl: "https://c4cker-labs-api.lucianomps2015.workers.dev" }}>
    const rankingState = document.querySelector("[data-ranking-state]");
    const escapeHtml = (value) => String(value).replace(/[&<>'"]/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", "\"": "&quot;" }[character]));
    fetch(`${apiUrl}/ranking`, { headers: { Accept: "application/json" } }).then(async (result) => {
      const payload = await result.json();
      if (!result.ok || !payload.ok) throw new Error("ranking");
      if (!payload.ranking?.length) { rankingState.textContent = "Todavía no hay solves registrados."; return; }
      rankingState.innerHTML = `<div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead class="font-mono text-xs uppercase text-signal"><tr><th class="pb-3 pr-6">#</th><th class="pb-3 pr-6">Nickname</th><th class="pb-3">Puntos</th></tr></thead><tbody>${payload.ranking.map((item, index) => `<tr class="border-t border-line"><td class="py-3 pr-6 font-mono text-[#718096]">${index + 1}</td><td class="py-3 pr-6">${escapeHtml(item.nickname)}</td><td class="py-3 font-mono text-electric">${item.points}</td></tr>`).join("")}</tbody></table></div>`;
    }).catch(() => { rankingState.textContent = "No se pudo cargar el ranking. Intentá nuevamente más tarde."; });
  </script>
</Base>
