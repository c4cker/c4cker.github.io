---
import Base from "../../layouts/LabsLayout.astro";
import { challenges } from "../../data/challenges";
export const prerender = true;
export function getStaticPaths() { return challenges.map((challenge) => ({ params: { slug: challenge.id }, props: { challenge } })); }
const { challenge } = Astro.props;
---
<Base title={challenge.title} description={challenge.description}>
  <article class="container-site max-w-5xl py-16 sm:py-20">
    <a class="back-link font-mono" href="/desafios">← Volver</a>
    <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_17rem]"><div><div class="flex flex-wrap gap-x-4 gap-y-2"><p class="eyebrow">{challenge.category} · {challenge.difficulty}</p><span class="font-mono text-xs text-[#a9b6c8]">{challenge.duration}</span></div><h1 class="mt-4 font-display text-5xl font-bold tracking-[-.07em] sm:text-6xl">{challenge.title}</h1><p class="mt-5 max-w-2xl text-lg text-[#cbd5e1]">{challenge.description}</p></div><aside class="border-l border-electric/50 pl-4 font-mono text-xs leading-6 text-[#a9b6c8]"><span class="text-signal">ENTREGA</span><br />{challenge.delivery}<br /><br /><span class="text-signal">ARTEFACTO</span><br />{challenge.artifact}</aside></div>
    <section class="mt-10 border border-line bg-panel/70 p-6"><p class="eyebrow">Objetivo verificable</p><p class="mt-3 text-lg">{challenge.objective}</p></section>
    <form class="mt-8 grid max-w-xl gap-3 border border-line bg-panel p-5" data-flag-form data-challenge={challenge.slug}><label class="font-mono text-sm" for="flag">Flag obtenida</label><input class="border border-line bg-void p-3" id="flag" name="flag" autocomplete="off" maxlength="512" placeholder="C4CKER{...}" required /><button class="w-max cursor-pointer border border-signal bg-signal px-4 py-3 font-mono text-xs font-bold text-void hover:bg-transparent hover:text-signal" type="submit">Validar flag</button><output class="min-h-6 text-sm text-[#a9b6c8]" aria-live="polite"></output></form>
    <dialog class="nickname-dialog" data-nickname-dialog aria-labelledby="nickname-title"><form method="dialog" data-nickname-form><p class="eyebrow">Hall of Fame</p><h2 id="nickname-title" class="mt-2 font-display text-2xl font-bold">¿Con qué nombre querés aparecer?</h2><p class="mt-2 text-sm text-[#a9b6c8]">Es opcional. Máximo 32 caracteres; podés usar el nombre que quieras.</p><input class="mt-4 w-full border border-line bg-void p-3" data-nickname-input maxlength="32" autocomplete="nickname" placeholder="Tu nickname" /><div class="mt-4 flex gap-3"><button class="border border-signal bg-signal px-4 py-3 font-mono text-xs font-bold text-void" value="save">Guardar nickname</button><button class="border border-line px-4 py-3 font-mono text-xs text-[#cbd5e1]" value="skip">Omitir</button></div></form></dialog>
  </article>
  <script>
    // @ts-nocheck - script inline a tipar cuando se extraiga el formulario.
    const flagForm = document.querySelector("[data-flag-form]"); const nicknameDialog = document.querySelector("[data-nickname-dialog]"); const nicknameForm = document.querySelector("[data-nickname-form]"); const nicknameInput = document.querySelector("[data-nickname-input]"); let pendingFlag = "";
    const submitFlag = async (nickname = "") => { const output = flagForm?.querySelector("output"); if (!flagForm || !output) return; output.textContent = "Verificando…"; try { const response = await fetch("/api/submit-flag", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ challenge_slug: flagForm.dataset.challenge, flag: pendingFlag, nickname }) }); const result = await response.json(); output.textContent = result.message; if (response.ok) { flagForm.reset(); window.localStorage.setItem("c4cker-hof-nickname-seen", "1"); } } catch { output.textContent = "No se pudo conectar con el servicio de flags."; } };
    flagForm?.addEventListener("submit", (event) => { event.preventDefault(); const flag = new FormData(flagForm).get("flag"); if (typeof flag !== "string") return; pendingFlag = flag.trim(); if (!window.localStorage.getItem("c4cker-hof-nickname-seen") && nicknameDialog instanceof HTMLDialogElement) { nicknameDialog.showModal(); nicknameInput?.focus(); } else submitFlag(window.localStorage.getItem("c4cker-hof-nickname") ?? ""); });
    nicknameForm?.addEventListener("submit", (event) => { event.preventDefault(); const action = event.submitter?.getAttribute("value"); const nickname = action === "save" && nicknameInput instanceof HTMLInputElement ? nicknameInput.value.trim().slice(0, 32) : ""; if (nickname) window.localStorage.setItem("c4cker-hof-nickname", nickname); window.localStorage.setItem("c4cker-hof-nickname-seen", "1"); if (nicknameDialog instanceof HTMLDialogElement) nicknameDialog.close(); submitFlag(nickname); });
  </script>
</Base>
