---
import Base from "../../layouts/LabsLayout.astro";
import { challenges } from "../../data/challenges";
import type { ChallengeResource, ChallengeStage } from "../../data/challenges";
export const prerender = true;
export function getStaticPaths() { return challenges.map((challenge) => ({ params: { slug: challenge.id }, props: { challenge } })); }
const { challenge } = Astro.props;
const challengesHref = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/desafios`;
const flagsApiUrl = import.meta.env.PUBLIC_FLAGS_API_URL || "https://c4cker-labs-api.lucianomps2015.workers.dev";
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || "";
const supabasePublishableKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || "";
---
<Base title={challenge.title} description={challenge.description}>
  <article class="container-site max-w-5xl py-16 sm:py-20">
    <a class="back-link font-mono" href={challengesHref}>← Volver</a>
    <div class="mt-8"><div class="flex flex-wrap gap-x-4 gap-y-2"><p class="eyebrow">{challenge.category} · {challenge.difficulty}</p><span class="font-mono text-xs text-[#a9b6c8]">{challenge.duration}</span></div><h1 class="mt-4 font-display text-5xl font-bold tracking-[-.07em] sm:text-6xl">{challenge.title}</h1><p class="mt-5 max-w-2xl text-lg text-[#cbd5e1]">{challenge.description}</p></div>
    <section class="mt-10 border border-line bg-panel/70 p-6"><p class="eyebrow">{challenge.flagMode}</p><p class="mt-3 text-lg">{challenge.objective}</p>{challenge.stages.length > 0 && <ol class="mt-6 grid gap-3">{challenge.stages.map((stage: ChallengeStage, index: number) => <li class="border-l border-line pl-4"><span class="font-mono text-xs text-signal">ETAPA {index + 1} · {stage.id}</span><h2 class="mt-1 font-display text-xl font-bold">{stage.title}</h2><p class="mt-1 text-sm text-[#a9b6c8]">{stage.objective}</p></li>)}</ol>}<a class="mt-6 inline-block border border-signal bg-signal px-4 py-3 font-mono text-xs font-bold text-void no-underline hover:bg-transparent hover:text-signal" href={challenge.downloadUrl} data-root-link>Descargar desafío ↓</a><div class="mt-8 border-t border-line pt-6"><p class="eyebrow">Qué vas a practicar</p><p class="mt-3 text-sm leading-6 text-[#cbd5e1]">{challenge.practiceHint}</p><div class="mt-6"><p class="font-mono text-xs text-signal">Dónde buscar</p><ul class="mt-3 grid gap-3">{challenge.resources.map((resource: ChallengeResource) => <li><a class="group inline-flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm text-[#cbd5e1] underline decoration-line hover:text-signal" href={resource.href} target="_blank" rel="noreferrer noopener"><span>{resource.title}</span><span class="font-mono text-xs text-[#718096] no-underline group-hover:text-signal">{resource.source}</span></a></li>)}</ul></div></div></section>
    <section class="mt-6 max-w-2xl border border-line bg-panel p-5"><p class="eyebrow">Cómo ejecutarlo</p>{challenge.format === "html" ? <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm text-[#cbd5e1]"><li>Descargá y extraé el ZIP.</li><li>Abrí <code>index.html</code> en tu navegador.</li><li>Abrí el <code>README.md</code> y seguí las instrucciones.</li></ol> : <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm text-[#cbd5e1]"><li>Descargá y extraé el ZIP.</li><li>Con Docker Desktop iniciado, abrí una terminal en esa carpeta.</li><li>Ejecutá <code>docker compose up --build</code>.</li><li>Seguí la URL y el comando de cierre del <code>README.md</code>.</li></ol>}</section>
    <form class="mt-8 grid max-w-xl gap-3 border border-line bg-panel p-5" data-flag-form data-challenge={challenge.slug} data-api-url={flagsApiUrl} data-supabase-url={supabaseUrl} data-supabase-key={supabasePublishableKey}><div class="grid gap-2"><label class="font-mono text-sm" for="flag">Flag obtenida</label><p class="text-xs leading-5 text-[#718096]" data-auth-state>Iniciá sesión para registrar el desafío.</p><button class="w-max cursor-pointer border border-line px-4 py-3 font-mono text-xs font-bold text-[#cbd5e1] hover:border-signal hover:text-signal" data-login type="button">Iniciar sesión con GitHub</button></div>{challenge.stages.length > 0 && <select class="border border-line bg-void p-3" id="stage" name="stage" aria-label="Etapa"><option value="">Seleccioná una etapa</option>{challenge.stages.map((stage: ChallengeStage, index: number) => <option value={stage.id}>Etapa {index + 1} · {stage.title}</option>)}</select>}<input class="border border-line bg-void p-3" id="flag" name="flag" autocomplete="off" minlength="40" maxlength="72" pattern="C4CKER\{[A-Za-z0-9]{32,64}\}" placeholder="C4CKER&#123;32–64 caracteres&#125;" required /><button class="w-max cursor-pointer border border-signal bg-signal px-4 py-3 font-mono text-xs font-bold text-void hover:bg-transparent hover:text-signal" type="submit">Validar flag</button><output class="min-h-6 text-sm text-[#a9b6c8]" aria-live="polite"></output></form>
    <dialog class="nickname-dialog" data-nickname-dialog aria-labelledby="nickname-title">
      <form method="dialog" data-nickname-form class="grid gap-4">
        <p class="eyebrow">Primer solve detectado</p>
        <h2 id="nickname-title" class="font-display text-3xl font-bold tracking-[-.05em]">Elegí tu nickname</h2>
        <p class="text-sm leading-6 text-[#a9b6c8]">Usaremos este nombre para mostrar tus desafíos completados en el ranking.</p>
        <input class="border border-line bg-void p-3" name="nickname" maxlength="32" autocomplete="nickname" placeholder="Tu nickname" required />
      <button class="w-max cursor-pointer border border-signal bg-signal px-4 py-3 font-mono text-xs font-bold text-void hover:bg-transparent hover:text-signal" value="confirm" type="submit">Guardar nickname</button>
      </form>
    </dialog>
  </article>
  <script src="../../scripts/flag-submit.ts"></script>
</Base>
