---
import Base from "../../layouts/LabsLayout.astro";
import { challenges } from "../../data/challenges";
---
<Base title="Desafíos" description="Retos CTF locales para ejecutar únicamente en un entorno propio y aislado.">
  <section class="container-site max-w-6xl py-16 sm:py-20">
    <h1 class="mt-3 font-display text-5xl font-bold tracking-[-.07em] sm:text-6xl">Descargá un reto y<br /><span class="text-electric">seguí las pistas</span></h1>
    <p class="mt-5 max-w-2xl text-lg text-[#c2c8c0]">Elegí HTML o Docker, descargá el paquete y resolvelo en tu equipo. Después enviá la flag para comprobar el resultado.</p>
    {challenges.length > 0 && <div class="challenge-filters mt-8" role="group" aria-label="Filtrar desafíos">
      <button class="filter-button is-active" type="button" data-challenge-filter="all" aria-pressed="true">Todos</button>
      <button class="filter-button" type="button" data-challenge-filter="docker" aria-pressed="false">Docker</button>
      <button class="filter-button" type="button" data-challenge-filter="html" aria-pressed="false">HTML</button>
    </div>}
    <div class="mt-6 grid gap-4 md:grid-cols-2" data-challenge-list>
      {challenges.map((item) => <a class="card trace-card group" data-challenge-card data-format={item.format} href={`/desafios/${item.id}`}><div class="flex justify-between gap-3"><span class="eyebrow">{item.category}</span><span class="font-mono text-[10px] uppercase text-signal">{item.format}</span></div><h2 class="mt-4 font-display text-3xl font-bold tracking-[-.04em] group-hover:text-signal">{item.title}</h2><p class="mt-2 font-mono text-xs text-electric">{item.difficulty} · {item.duration} · {item.artifact}</p><p class="mt-4 text-[#a9b6c8]">{item.description}</p><p class="mt-4 font-mono text-[10px] uppercase text-signal">{item.flagMode}{item.stages.length ? ` · ${item.stages.length} etapas` : ""}</p></a>)}
    </div>
    {challenges.length > 0 ? <p class="mt-5 font-mono text-xs text-[#7f9b87]" data-challenge-empty hidden>No hay desafíos de este formato todavía.</p> : <p class="mt-10 border-l border-ember pl-4 font-mono text-sm text-[#a9b6c8]">Próximamente habrá desafíos para practicar.</p>}
  </section>
  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-challenge-filter]").forEach((button) => button.addEventListener("click", () => {
      const format = button.dataset.challengeFilter ?? "all";
      document.querySelectorAll<HTMLButtonElement>("[data-challenge-filter]").forEach((item) => { const active = item === button; item.classList.toggle("is-active", active); item.setAttribute("aria-pressed", String(active)); });
      let visible = 0;
      document.querySelectorAll<HTMLElement>("[data-challenge-card]").forEach((card) => { const show = format === "all" || card.dataset.format === format; card.hidden = !show; if (show) visible += 1; });
      const empty = document.querySelector<HTMLElement>("[data-challenge-empty]"); if (empty) empty.hidden = visible > 0;
    }));
  </script>
</Base>
