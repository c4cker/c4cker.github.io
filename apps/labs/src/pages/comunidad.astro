---
import Base from "../layouts/LabsLayout.astro";
import { communityPanels } from "../data/community";
---
<Base title="Comunidad" description="Paneles temáticos, comunidades y recursos externos para aprender seguridad de forma responsable.">
  <article class="container-site max-w-6xl py-16 sm:py-20">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_15rem]"><div><p class="eyebrow">Directorio compartido</p><h1 class="mt-3 font-display text-5xl font-bold tracking-[-.07em] sm:text-6xl">Elegí un tema.<br /><span class="text-electric">seguí el recorrido.</span></h1><p class="mt-5 max-w-2xl text-lg text-[#c2c8c0]">Paneles de estudio con una introducción breve y una selección curada de recursos externos para avanzar con contexto.</p></div><aside class="border-l border-ember/60 pl-4 font-mono text-xs leading-6 text-[#a9b6c8]"><span class="text-ember">regla de entrada</span><br />Trabajá solo con autorización. No publiques datos, credenciales ni flags. Compartí evidencia y mitigaciones.</aside></div>
    <section class="mt-14 grid gap-4 md:grid-cols-2" aria-label="Comunidades"><a class="community-invite no-underline" href="http://discord.gg/hwgAb2DMqu" target="_blank" rel="noreferrer noopener"><span class="community-logo" aria-hidden="true">D</span><p class="eyebrow">Co-fundador · Discord</p><h2 class="mt-4 font-display text-3xl font-bold">CyberSecTuc</h2><p class="mt-3 text-[#a9b6c8]">Comunidad local de ciberseguridad con charlas y talleres en Tucumán.</p><span class="route-link mt-6">Unirme a CyberSecTuc ↗</span></a><a class="community-invite no-underline" href="https://discord.gg/z6cr5JF6bJ" target="_blank" rel="noreferrer noopener"><span class="community-logo" aria-hidden="true">D</span><p class="eyebrow">Administrador · Discord</p><h2 class="mt-4 font-display text-3xl font-bold">DedSec - VT Security</h2><p class="mt-3 text-[#a9b6c8]">Espacio donde modero junto a la comunidad de Valentín Torassa.</p><span class="route-link mt-6">Abrir DedSec ↗</span></a></section>
    <section class="mt-16" aria-labelledby="paneles-title"><div class="flex items-end justify-between gap-4"><div><p class="eyebrow">Rutas de estudio</p><h2 id="paneles-title" class="mt-3 font-display text-3xl font-bold tracking-[-.05em] sm:text-4xl">Paneles temáticos</h2></div><span class="font-mono text-xs text-[#718096]">{communityPanels.length} áreas</span></div><div class="mt-7 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{communityPanels.map((panel) => <a class="community-panel trace-card group no-underline" href={`/comunidad/${panel.slug}`}><p class="eyebrow">{panel.eyebrow}</p><h3 class="mt-5 font-display text-3xl font-bold tracking-[-.05em] group-hover:text-signal">{panel.title}</h3><p class="mt-4 text-[#a9b6a8]">{panel.description}</p><span class="route-link mt-7">Ver recursos <span aria-hidden="true">→</span></span></a>)}</div></section>
  </article>
</Base>
