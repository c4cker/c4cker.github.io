---
import Base from "../layouts/LabsLayout.astro";
import { communityResources } from "../data/community";
---
<Base title="Comunidad" description="Comunidades, recursos y lugares confiables para aprender seguridad de forma responsable.">
  <article class="container-site max-w-6xl py-16 sm:py-20">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_15rem]"><div><p class="eyebrow">Directorio compartido</p><h1 class="mt-3 font-display text-5xl font-bold tracking-[-.07em] sm:text-6xl">La comunidad es<br /><span class="text-electric">el mapa, no el ruido.</span></h1><p class="mt-5 max-w-2xl text-lg text-[#c2c8c0]">Espacios que forman parte de mi recorrido, más referencias para practicar con permiso, investigar mejor y devolver contexto a otras personas.</p></div><aside class="border-l border-ember/60 pl-4 font-mono text-xs leading-6 text-[#a9b6c8]"><span class="text-ember">regla de entrada</span><br />No ataques sistemas ajenos. No publiques datos, credenciales o flags. Compartí evidencia y mitigaciones.</aside></div>
    <section class="mt-12 grid gap-4 md:grid-cols-2"><a class="community-invite no-underline" href="http://discord.gg/hwgAb2DMqu" target="_blank" rel="noreferrer noopener"><span class="community-logo" aria-hidden="true">D</span><p class="eyebrow">Co-fundador · Discord</p><h2 class="mt-4 font-display text-3xl font-bold">CyberSecTuc</h2><p class="mt-3 text-[#a9b6c8]">Una comunidad local de tecnología y ciberseguridad que construimos para acercar formación, charlas, talleres y oportunidades.</p><span class="route-link mt-6">Unirme a CyberSecTuc ↗</span></a><a class="community-invite no-underline" href="https://discord.gg/z6cr5JF6bJ" target="_blank" rel="noreferrer noopener"><span class="community-logo" aria-hidden="true">D</span><p class="eyebrow">Administrador · Discord</p><h2 class="mt-4 font-display text-3xl font-bold">DedSec - VT Security</h2><p class="mt-3 text-[#a9b6c8]">Espacio donde modero junto a la comunidad de <span class="text-signal">Valentín Torassa</span> y sigo aprendiendo con otras personas.</p><span class="route-link mt-6">Abrir DedSec ↗</span></a></section>
    <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{communityResources.map((item) => <a class="card trace-card group" href={item.href} target="_blank" rel="noreferrer noopener"><span class="eyebrow">{item.category}</span><h2 class="mt-4 font-display text-2xl font-bold tracking-[-.04em] group-hover:text-signal">{item.title}</h2><p class="mt-2 font-mono text-xs text-electric">{item.source}</p><p class="mt-4 text-[#a9b6c8]">{item.description}</p><span class="route-link mt-7">Abrir recurso <span aria-hidden="true">↗</span></span></a>)}</div>
  </article>
</Base>
