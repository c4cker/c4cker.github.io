{
  "name": "c4cker-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260828.1": true
  },
  "scripts": {
    "dev": "npm exec concurrently -- --kill-others-on-fail --names main,labs,blog --prefix-colors cyan,green,magenta \"node scripts/astro.mjs main dev --force --port 4321\" \"node scripts/astro.mjs labs dev --ignore-lock --host labs.localhost --port 4322\" \"bundle exec --gemfile apps/blog/Gemfile jekyll serve --source apps/blog --destination apps/blog/_site --livereload --port 4000\"",
    "dev:main": "node scripts/astro.mjs main dev --port 4321",
    "dev:blog": "bundle exec --gemfile apps/blog/Gemfile jekyll serve --source apps/blog --destination apps/blog/_site --livereload --port 4000",
    "dev:labs": "node scripts/astro.mjs labs dev --ignore-lock --host labs.localhost --port 4322",
    "build": "npm run build:main",
    "build:main": "node scripts/astro.mjs main build",
    "build:labs": "node scripts/astro.mjs labs build",
    "build:all": "node scripts/verify-all.mjs --build",
    "preview": "node scripts/astro.mjs main preview",
    "prod": "node scripts/prod.mjs",
    "check": "node scripts/astro.mjs main check",
    "check:all": "node scripts/verify-all.mjs --check",
    "flag:new": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/new-flag.ps1",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "worker:check": "node scripts/check-worker-contract.mjs",
    "community:check": "node scripts/check-community.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.6",
    "@supabase/supabase-js": "^2.114.0",
    "@tailwindcss/vite": "^4.1.12",
    "astro": "^7.2.10",
    "tailwindcss": "^4.1.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "concurrently": "^10.0.5",
    "typescript": "^6.0.3"
  }
}
