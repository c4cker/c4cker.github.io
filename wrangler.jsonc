{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "c4cker-labs-api",
  "main": "workers/labs-api.ts",
  "compatibility_date": "2026-08-29",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }
  ]
}
